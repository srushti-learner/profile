---
interface Props { variant: string; caption: string }
const { variant, caption } = Astro.props;
---
<div class:list={['work-art', `art-${variant}`]} aria-hidden="true">
  {variant === 'cloud' ? (
    <svg viewBox="0 0 480 260" fill="none">
      <path d="M75 186 240 94l165 92-165 92z" fill="currentColor" opacity=".06" />
      <path d="m75 157 165-92 165 92-165 92z" stroke="currentColor" opacity=".25" />
      <path d="m75 126 165-92 165 92-165 92z" fill="var(--art-fill)" stroke="currentColor" stroke-width="1.5" />
      <path d="m75 126 165 92v31M405 126v31M75 126v31M240 34v60" stroke="currentColor" opacity=".3" />
      <path d="m196 123 44-25 44 25-44 25z" fill="currentColor" opacity=".8" />
      <path d="m196 123 44 25v29l-44-25z" fill="currentColor" opacity=".45" />
      <path d="m284 123-44 25v29l44-25z" fill="currentColor" opacity=".65" />
      <path d="m130 126 36-20M314 168l36-20M296 74l36 20" stroke="currentColor" stroke-width="2" />
      <circle cx="130" cy="126" r="4" fill="currentColor" />
      <circle cx="350" cy="148" r="4" fill="currentColor" />
    </svg>
  ) : variant === 'tools' ? (
    <svg viewBox="0 0 480 260" fill="none">
      <rect x="76" y="35" width="328" height="190" rx="10" stroke="currentColor" stroke-width="1.5" />
      <path d="M76 65h328M142 65v160" stroke="currentColor" opacity=".35" />
      <circle cx="91" cy="50" r="2" fill="currentColor" opacity=".6" />
      <circle cx="101" cy="50" r="2" fill="currentColor" opacity=".4" />
      <circle cx="111" cy="50" r="2" fill="currentColor" opacity=".25" />
      <path d="M91 87h33M91 101h24M91 115h29" stroke="currentColor" stroke-width="2" opacity=".4" />
      <path d="m202 99 68 45 68-45M202 190l68-46 68 46" stroke="currentColor" opacity=".4" />
      <circle cx="202" cy="99" r="10" fill="var(--art-fill)" stroke="currentColor" />
      <circle cx="338" cy="99" r="10" fill="var(--art-fill)" stroke="currentColor" />
      <circle cx="202" cy="190" r="10" fill="var(--art-fill)" stroke="currentColor" />
      <circle cx="338" cy="190" r="10" fill="var(--art-fill)" stroke="currentColor" />
      <rect x="245" y="119" width="50" height="50" rx="13" fill="currentColor" />
      <path d="M270 131v26M257 144h26m-22-9 18 18m0-18-18 18" stroke="var(--art-fill)" stroke-width="1.5" />
    </svg>
  ) : (
    <svg viewBox="0 0 480 260" fill="none">
      <rect x="104" y="63" width="144" height="164" rx="8" transform="rotate(-12 104 63)" fill="var(--art-fill)" stroke="currentColor" opacity=".35" />
      <rect x="229" y="34" width="144" height="164" rx="8" transform="rotate(12 229 34)" fill="var(--art-fill)" stroke="currentColor" opacity=".35" />
      <rect x="169" y="45" width="142" height="174" rx="8" fill="var(--art-fill)" stroke="currentColor" />
      <path d="M185 61h110v98H185z" fill="currentColor" opacity=".1" />
      <circle cx="240" cy="109" r="28" fill="currentColor" opacity=".9" />
      <path d="m234 97 17 12-17 12z" fill="var(--art-fill)" />
      <path d="M185 177h76M185 190h49" stroke="currentColor" stroke-width="3" opacity=".5" />
      <path d="m276 178 3 6 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1z" fill="currentColor" />
    </svg>
  )}
  <span class="art-caption">{caption}</span>
</div>
