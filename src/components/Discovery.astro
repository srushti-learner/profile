---
import { siteConfig } from '../config';
---
<section id="work" aria-labelledby="work-title" class="p-8 sm:p-12 md:p-16 lg:p-24">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
    <div class="lg:col-span-4">
      <h2 id="work-title" class="text-3xl sm:text-4xl md:text-5xl xl:text-6xl font-bold text-gray-900">Microsoft<br />Discovery</h2>
      <div class="w-[75px] h-[5px] mt-2 rounded-full" style={{ backgroundColor: siteConfig.accentColor }}></div>
      <p class="mt-6 text-base sm:text-lg text-gray-600">{siteConfig.foundingRole}</p>
      <p class="mt-5 text-sm text-gray-500">Announced at Microsoft Build.</p>
    </div>
    <div class="lg:col-span-8 space-y-8">
      {siteConfig.discovery.map((product) => (
        <article class="p-4 sm:p-6 md:p-8 bg-gray-50 rounded-xl sm:rounded-2xl border border-gray-200" aria-labelledby={`${product.id}-title`}>
          <p class="text-xs sm:text-sm" style={{ color: siteConfig.accentColor }}>{product.number} / {product.category}</p>
          <h3 id={`${product.id}-title`} class="text-xl sm:text-2xl md:text-3xl font-bold text-gray-900 mt-3">{product.title}</h3>
          <p class="mt-3 text-base sm:text-lg text-gray-600">{product.description}</p>
          <div class="product-context mt-6"><h4 class="font-semibold text-gray-900">Product context</h4><p class="mt-2 text-sm sm:text-base text-gray-600 leading-relaxed">{product.context}</p></div>
          <div class="contributions mt-6"><h4 class="font-semibold text-gray-900">My contributions</h4><ul class="mt-3 space-y-2">{product.contributions.map((contribution) => <li class="flex items-start"><span class="inline-block w-1.5 h-1.5 rounded-full bg-gray-400 mt-2 mr-3 shrink-0"></span><span class="text-sm sm:text-base text-gray-600">{contribution}</span></li>)}</ul></div>
          <ul class="flex flex-wrap gap-2 mt-6" aria-label="Technologies">{product.tags.map((tag) => <li class="px-3 py-1.5 bg-gray-900 text-white rounded-lg text-xs sm:text-sm font-medium">{tag}</li>)}</ul>
          <div class="product-references flex flex-wrap gap-x-6 gap-y-2 mt-5 text-sm" style={{ color: siteConfig.accentColor }}><a class="inline-flex items-center min-h-11 underline underline-offset-4" href={product.source} aria-label={`${product.title} product overview`}>Product overview <span class="ml-2" aria-hidden="true">↗</span></a><a class="inline-flex items-center min-h-11 underline underline-offset-4" href={product.announcement} aria-label={`${product.title} Build announcement`}>Build announcement <span class="ml-2" aria-hidden="true">↗</span></a></div>
          <details class="discovery-details mt-5 border-t border-gray-200">
            <summary class="flex items-center justify-between min-h-14 py-3 text-sm text-gray-900">Behind the work <span class="details-icon text-2xl transition-transform" aria-hidden="true">+</span></summary>
            <div class="space-y-4 pb-4 text-sm sm:text-base text-gray-600">
              <div><h4 class="font-semibold text-gray-900 mb-1">The problem</h4><p>{product.problem}</p></div>
              <div><h4 class="font-semibold text-gray-900 mb-1">My contribution</h4><p>{product.contribution}</p></div>
              <div><h4 class="font-semibold text-gray-900 mb-1">The thinking</h4><p>{product.decisions}</p></div>
              <div><h4 class="font-semibold text-gray-900 mb-1">The outcome</h4><p>{product.outcome}</p></div>
            </div>
          </details>
        </article>
      ))}
      <p class="text-xs sm:text-sm text-gray-500 leading-relaxed">Product context is based on Microsoft’s public announcements and documentation. My contributions describe my work within the wider product teams; internal details are intentionally omitted.</p>
    </div>
  </div>
</section>
