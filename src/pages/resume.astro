---
import Layout from '../layouts/Layout.astro';
import { profile, experience, projects, skillGroups } from '../data/profile';
---
<Layout title="Résumé — Srushti Borate" description="Public-safe résumé of Srushti Borate, software engineer at Microsoft.">
  <header class="resume-toolbar container"><a class="text-link" href={import.meta.env.BASE_URL}>← Back to portfolio</a><button class="button button-dark" id="print-resume" type="button">Print / Save PDF <span aria-hidden="true">↗</span></button></header>
  <main id="main" class="resume container">
    <div class="resume-heading"><p class="eyebrow">RÉSUMÉ</p><h1>{profile.name}</h1><p class="resume-subtitle">{profile.role} · {profile.positioning}</p><div class="resume-links"><span>{profile.email}</span><a href={profile.github}>github.com/srushti-learner</a><a href={profile.linkedin}>LinkedIn profile</a></div></div>
    <section aria-labelledby="resume-experience"><h2 id="resume-experience">Experience</h2>{experience.map((job) => <article><div class="resume-row"><h3>{job.role} · {job.company}</h3><span>{job.period}</span></div><p>{job.description}</p>{job.highlights.map((highlight) => <div class="resume-highlight"><h4>{highlight.title}</h4><p>{highlight.description}</p></div>)}</article>)}</section>
    <section aria-labelledby="resume-projects"><h2 id="resume-projects">Selected projects</h2>{projects.map((project) => <article><div class="resume-row"><h3>{project.title}</h3><span>{project.date}</span></div><p>{project.description}</p>{project.relatedTools && <p>Related tooling expertise: {project.relatedTools.join(' · ')}</p>}<p class="project-tags">{project.tags}</p></article>)}</section>
    <section aria-labelledby="resume-education"><h2 id="resume-education">Education</h2><div class="resume-row"><h3>Indian Institute of Technology Roorkee</h3><span>2020 — 2024</span></div><p>B.Tech, Electrical Engineering · CGPA 8.55 / 10</p></section>
    <section aria-labelledby="resume-skills"><h2 id="resume-skills">Technical skills</h2>{skillGroups.map((group) => <p><strong>{group.label}: </strong>{group.items.join(' · ')}</p>)}</section>
    <p class="resume-note">This public résumé intentionally omits confidential project and operational details.</p>
    <noscript><p>Use your browser’s Print command to print this résumé or save it as a PDF.</p></noscript>
  </main>
  <script>document.getElementById('print-resume')?.addEventListener('click', () => window.print());</script>
</Layout>
