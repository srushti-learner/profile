---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/srushti-graduation.webp';
import WorkArt from '../components/WorkArt.astro';
import { profile, work, experience, projects } from '../data/profile';
const base = import.meta.env.BASE_URL;
---
<Layout>
  <header class="site-header container">
    <a class="wordmark" href={base} aria-label="sb/ — Srushti Borate home">sb<span>/</span></a>
    <nav class="desktop-nav" aria-label="Main navigation">
      <a class="nav-link" href="#work">Work</a>
      <a class="nav-link" href="#experience">Journey</a>
      <a class="nav-link" href="#about">About</a>
      <a class="nav-link" href="#contact">Contact <span aria-hidden="true">↗</span></a>
    </nav>
    <div class="header-controls">
      <button id="theme-toggle" class="control-button" type="button" aria-label="Use dark theme" aria-pressed="false" hidden><span class="theme-symbol" aria-hidden="true">◐</span><span data-theme-label>Dark</span></button>
      <button id="menu-toggle" class="control-button" type="button" aria-haspopup="dialog" aria-controls="navigation-menu" hidden>Menu <span class="menu-icon" aria-hidden="true"><i></i><i></i></span></button>
    </div>
  </header>

  <dialog id="navigation-menu" class="menu-dialog" aria-labelledby="menu-title">
    <div class="menu-top"><p id="menu-title" class="eyebrow">THE SHORTCUTS</p><form method="dialog"><button class="control-button" type="submit" aria-label="Close menu">Close <span aria-hidden="true">×</span></button></form></div>
    <nav aria-label="Expanded navigation">
      <a href="#work"><span>01</span>Selected work <span aria-hidden="true">↗</span></a>
      <a href="#experience"><span>02</span>The journey <span aria-hidden="true">↗</span></a>
      <a href="#projects"><span>03</span>Explorations <span aria-hidden="true">↗</span></a>
      <a href="#about"><span>04</span>Beyond the code <span aria-hidden="true">↗</span></a>
      <a href="#contact"><span>05</span>Say hello <span aria-hidden="true">↗</span></a>
    </nav>
    <a class="text-link" href={`${base}resume/`}>View résumé <span aria-hidden="true">↗</span></a>
  </dialog>

  <main id="main" tabindex="-1">
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-meta"><p class="eyebrow">SOFTWARE ENGINEER AT MICROSOFT</p><p class="eyebrow">CLOUD / AI / DEVELOPER EXPERIENCE</p></div>
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="hero-hello">Hello, I’m</p>
          <h1 id="hero-title"><span class="intro-line">Srushti </span><span class="intro-line">Borate<span class="name-dot">.</span></span></h1>
          <p class="founding-role"><span class="founding-mark" aria-hidden="true">↗</span><strong>{profile.discoveryRole}</strong></p>
          <p class="hero-description">I build AI and cloud platforms.<br />Thoughtful systems. Real-world impact.</p>
          <div class="hero-actions"><a class="button button-dark" href="#work">Explore my work <span aria-hidden="true">↘</span></a><a class="text-link" href={`${base}resume/`}>View résumé <span aria-hidden="true">↗</span></a></div>
          <div class="hero-socials"><a href={profile.github}>GitHub <span aria-hidden="true">↗</span></a><a href={profile.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a></div>
        </div>
        <figure class="hero-portrait" id="profile-photo">
          <div class="photo-index"><span class="eyebrow">A LITTLE PERSPECTIVE</span><span aria-hidden="true">[ 01 ]</span></div>
          <div class="portrait-frame"><Image src={portrait} alt="Srushti Borate at her IIT Roorkee graduation, with the campus building behind her" width={1200} height={1600} widths={[360, 600, 900, 1200]} sizes="(max-width: 760px) calc(100vw - 48px), (max-width: 1100px) 36vw, 440px" loading="eager" decoding="async" /></div>
          <figcaption><span>IIT ROORKEE · 2024</span><span>Engineering roots.<br />A wider perspective.</span></figcaption>
        </figure>
      </div>
      <div class="hero-foot"><p>From enterprise cloud to local agentic AI.</p><a class="scroll-cue" href="#work">SCROLL TO EXPLORE <span aria-hidden="true">↓</span></a></div>
    </section>

    <section id="work" class="section work-section" aria-labelledby="work-title">
      <div class="container">
        <div class="section-heading" data-reveal><div><p class="eyebrow">01 / SELECTED WORK</p><h2 id="work-title">Building what’s<br /><em>next.</em></h2></div><p>My work as a founding engineer.<br />Two experiences. One Microsoft Discovery.</p></div>
        <div class="build-highlight"><p class="eyebrow">ANNOUNCED AT MICROSOFT BUILD</p><a class="text-link" href={work[1].announcement}>Read the announcement <span aria-hidden="true">↗</span></a></div>
        <div class="work-switcher" aria-label="Discovery experiences" hidden>
          <button id="tab-discovery-platform" type="button" data-work-tab="discovery-platform"><span>01</span> Enterprise platform <span aria-hidden="true">↗</span></button>
          <button id="tab-discovery-app" type="button" data-work-tab="discovery-app"><span>02</span> Local app <span aria-hidden="true">↗</span></button>
        </div>
        <div class="work-gallery">
          {work.map((item) => (
            <div class="work-panel" id={`panel-${item.id}`}>
              <article class="work-card" aria-labelledby={`${item.id}-title`}>
                <div class="work-visual">
                  <p class="visual-index"><span class="eyebrow">DISCOVERY / {item.number}</span><span aria-hidden="true">↗</span></p>
                  <WorkArt variant={item.variant} caption={item.artCaption} />
                  <ul class="tags" aria-label="Technologies">{item.tags.map((tag) => <li>{tag}</li>)}</ul>
                </div>
                <div class="work-card-content">
                  <p class="eyebrow">{item.category}</p><h3 id={`${item.id}-title`}>{item.title}</h3><p class="card-description">{item.description}</p>
                  <div class="product-context"><h4>Product context</h4><p>{item.context}</p></div>
                  <div class="contributions"><h4>My contributions</h4><ul>{item.contributions.map((contribution) => <li>{contribution}</li>)}</ul></div>
                  <div class="product-references"><a href={item.source} aria-label={`${item.title} product overview`}>Product overview <span aria-hidden="true">↗</span></a><a href={item.announcement} aria-label={`${item.title} Build announcement`}>Build announcement <span aria-hidden="true">↗</span></a></div>
                  <details class="case-study"><summary>Behind the work <span class="details-icon" aria-hidden="true">+</span></summary><div class="case-study-body"><h4>The problem</h4><p>{item.problem}</p><h4>My contribution</h4><p>{item.contribution}</p><h4>The thinking</h4><p>{item.decisions}</p><h4>The outcome</h4><p>{item.outcome}</p></div></details>
                </div>
              </article>
            </div>
          ))}
        </div>
        <p class="work-disclaimer">Product context is based on Microsoft’s public announcements and documentation. My contributions describe my work within the wider product teams; internal details are intentionally omitted.</p>
        <div class="expertise" aria-labelledby="expertise-title">
          <h3 id="expertise-title" class="eyebrow">THE ENGINEERING THREADS</h3>
          <div><span>01</span><h4>Cloud foundations</h4><p>Azure · C# / .NET · APIs · Identity</p></div>
          <div><span>02</span><h4>AI, connected</h4><p>MCP · Agentic tooling · Desktop delivery</p></div>
          <div><span>03</span><h4>From code to delivery</h4><p>CI/CD · Observability · Testing</p></div>
        </div>
      </div>
    </section>

    <section id="experience" class="section container" aria-labelledby="experience-title">
      <div class="section-heading" data-reveal><div><p class="eyebrow">02 / THE JOURNEY</p><h2 id="experience-title">Learning.<br />Building. <em>Growing.</em></h2></div><a class="text-link" href={`${base}resume/`}>The full résumé <span aria-hidden="true">↗</span></a></div>
      <div class="timeline">
        {experience.map((job) => (
          <article class="experience-item" data-reveal><div class="job-meta"><span>{job.period}</span><span>{job.type}</span></div><div><h3>{job.role}</h3><p class="company">{job.company}</p></div><p>{job.description}</p></article>
        ))}
        <article class="experience-item education" data-reveal><div class="job-meta"><span>2020 — 2024</span><span>Education</span></div><div><h3>IIT Roorkee</h3><p class="company">B.Tech · Electrical Engineering</p></div><p>A foundation in solving problems.<br />CGPA 8.55 / 10</p></article>
      </div>
    </section>

    <section id="projects" class="section container" aria-labelledby="projects-title">
      <div class="section-heading" data-reveal><div><p class="eyebrow">03 / EXPLORATIONS</p><h2 id="projects-title">Curiosity,<br /><em>in practice.</em></h2></div><p>Different domains.<br />The same drive to connect the dots.</p></div>
      <div class="project-list">
        {projects.map((project, index) => (
          <details class="project-row" data-reveal>
            <summary><span class="project-number">0{index + 1}</span><span class="project-title"><span class="eyebrow">{project.category}</span><span>{project.title}</span></span><span class="project-date">{project.date}</span><span class="project-arrow" aria-hidden="true">↗</span></summary>
            <div class="project-body"><p>{project.description}</p><p class="project-tags">{project.tags}</p></div>
          </details>
        ))}
      </div>
      <a class="text-link github-link" href={profile.github}>Find me on GitHub <span aria-hidden="true">↗</span></a>
    </section>

    <section id="about" class="section about-section" aria-labelledby="about-title">
      <div class="container about-layout">
        <div class="about-statement" data-reveal><p class="eyebrow">04 / BEYOND THE CODE</p><h2 id="about-title">A systems<br />thinker.<br /><em>Always curious.</em></h2><p class="about-aside">An engineering mind.<br />A life beyond the keyboard.</p><a class="text-link" href="#profile-photo">Back to my roots <span aria-hidden="true">↑</span></a></div>
        <div class="about-copy" data-reveal><p class="about-lead">I’m Srushti, a software engineer at Microsoft and an IIT Roorkee graduate.</p><p>I work on Microsoft Discovery across its enterprise platform and local agentic AI app. I’m interested in the connections: between services, between tools, and between an engineering decision and the experience it creates.</p><p>My electrical engineering background and work in robotics gave me a starting point for thinking across boundaries. Today, I bring that perspective to software.</p><div class="off-screen"><p class="eyebrow">WHEN I LOG OFF</p><p>Outside of work, I’m a gym enthusiast and always up for a game of badminton or table tennis, or a swim. I also love travelling.</p><ul aria-label="Personal interests"><li>Gym</li><li>Badminton</li><li>Table tennis</li><li>Swimming</li><li>Travel</li></ul></div><a class="text-link" href={profile.linkedin}>More on LinkedIn <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>

    <section id="contact" class="contact-section" aria-labelledby="contact-title">
      <div class="container"><p class="eyebrow">05 / MAKE A CONNECTION</p><div class="contact-heading" data-reveal><h2 id="contact-title">Have a thought?<br />Let’s <em>talk.</em></h2><a class="contact-arrow" href={`mailto:${profile.email}`} aria-label="Email Srushti Borate"><span aria-hidden="true">↗</span></a></div><a class="email-link" href={`mailto:${profile.email}`}>{profile.email}</a><div class="contact-bottom"><p>Have an idea or a shared interest? Say hello.</p><div><a href={profile.github}>GitHub <span aria-hidden="true">↗</span></a><a href={profile.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a><a href={`${base}resume/`}>Résumé <span aria-hidden="true">↗</span></a></div></div></div>
    </section>
  </main>
  <footer class="site-footer container"><a class="wordmark" href={base}>sb<span>/</span></a><p>© {new Date().getFullYear()} Srushti Borate</p><a href="#main">Back to top <span aria-hidden="true">↑</span></a></footer>
  <script>
    const themeButton = document.querySelector<HTMLButtonElement>('#theme-toggle');
    if (themeButton) {
      const updateThemeButton = () => {
        const dark = document.documentElement.dataset.theme === 'dark';
        themeButton.setAttribute('aria-pressed', String(dark));
        themeButton.setAttribute('aria-label', dark ? 'Use light theme' : 'Use dark theme');
        const label = themeButton.querySelector('[data-theme-label]');
        if (label) label.textContent = dark ? 'Light' : 'Dark';
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', getComputedStyle(document.documentElement).getPropertyValue('--paper').trim());
      };
      updateThemeButton();
      themeButton.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        updateThemeButton();
        try { localStorage.setItem('portfolio-theme', theme); }
        catch (error) {
          if (error instanceof DOMException) console.warn('Theme preference could not be saved.', error);
          else throw error;
        }
      });
      themeButton.hidden = false;
    }

    const menu = document.querySelector<HTMLDialogElement>('#navigation-menu');
    const menuButton = document.querySelector<HTMLButtonElement>('#menu-toggle');
    if (menu && menuButton) {
      menuButton.addEventListener('click', () => menu.showModal());
      menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => menu.close()));
      menu.addEventListener('keydown', (event) => {
        if (event.key !== 'Tab') return;
        const controls = Array.from(menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));
        const first = controls[0];
        const last = controls[controls.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });
      menuButton.hidden = false;
    }

    const switcher = document.querySelector<HTMLElement>('.work-switcher');
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-work-tab]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('.work-panel'));
    if (switcher && tabs.length === panels.length && tabs.length > 0) {
      const selectTab = (index: number) => {
        tabs.forEach((tab, position) => {
          const selected = index === position;
          tab.setAttribute('aria-selected', String(selected));
          tab.tabIndex = selected ? 0 : -1;
          panels[position].hidden = !selected;
          panels[position].classList.toggle('active', selected);
        });
      };
      switcher.setAttribute('role', 'tablist');
      tabs.forEach((tab, index) => {
        tab.setAttribute('role', 'tab');
        tab.setAttribute('aria-controls', panels[index].id);
        panels[index].setAttribute('role', 'tabpanel');
        panels[index].setAttribute('aria-labelledby', tab.id);
        panels[index].tabIndex = 0;
        tab.addEventListener('click', () => selectTab(index));
        tab.addEventListener('keydown', (event) => {
          let next = index;
          if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
          else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === 'Home') next = 0;
          else if (event.key === 'End') next = tabs.length - 1;
          else return;
          event.preventDefault();
          selectTab(next);
          tabs[next].focus();
        });
      });
      selectTab(0);
      switcher.hidden = false;
    }
  </script>
</Layout>
