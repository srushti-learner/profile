---
import Layout from '../layouts/Layout.astro';
import WorkArt from '../components/WorkArt.astro';
import { profile, work, experience, projects } from '../data/profile';
const base = import.meta.env.BASE_URL;
---
<Layout>
  <header class="site-header container">
    <a class="wordmark" href={base} aria-label="Srushti Borate home">srushti<span>.</span></a>
    <nav aria-label="Main navigation">
      <a class="nav-link" href="#work">Work</a>
      <a class="nav-link" href="#experience">Experience</a>
      <a class="nav-link" href="#about">About</a>
      <a class="nav-contact" href="#contact">Let’s connect <span aria-hidden="true">↗</span></a>
    </nav>
  </header>

  <main id="main">
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow intro-line"><span class="status-dot"></span> SOFTWARE ENGINEER AT MICROSOFT</p>
        <p class="founding-role"><strong>{profile.discoveryRole}</strong></p>
        <h1 id="hero-title"><span class="intro-line">Thoughtful code.</span><span class="intro-line">Real-world <em>impact.</em></span></h1>
        <div class="hero-bottom intro-line">
          <div>
            <p class="hero-description">Hi, I’m Srushti. I help build Discovery’s enterprise platform on Azure and the local, agentic AI Discovery App.</p>
            <div class="hero-actions">
              <a class="button button-dark" href="#work">Explore my work <span aria-hidden="true">↘</span></a>
              <a class="text-link" href={`${base}resume/`}>View résumé <span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <div class="hero-note"><span class="mini-mark" aria-hidden="true">✳</span><p>Systems thinking.<br />Human perspective.</p></div>
        </div>
      </div>
      <div class="hero-foot">
        <p>CLOUD ENGINEERING <span aria-hidden="true">/</span> AI TOOLING <span aria-hidden="true">/</span> DEVELOPER EXPERIENCE</p>
        <a href="#work">A little further down <span aria-hidden="true">↓</span></a>
      </div>
    </section>

    <section id="work" class="section container" aria-labelledby="work-title">
      <div class="section-heading" data-reveal>
        <div><p class="eyebrow">01 / FEATURED WORK AT MICROSOFT</p><h2 id="work-title">Two experiences.<br />One <em>Discovery.</em></h2></div>
        <p><strong>My work as a founding engineer.</strong><br />Across enterprise and local experiences.</p>
      </div>
      <div class="build-highlight" data-reveal><p><span class="eyebrow">ANNOUNCED AT MICROSOFT BUILD</span><span>An enterprise platform. A complementary desktop app.</span></p><a class="text-link" href={work[1].announcement}>Read the announcement <span aria-hidden="true">↗</span></a></div>
      <div class="work-grid">
        {work.map((item) => (
          <article class="work-card" aria-labelledby={`${item.id}-title`} data-reveal>
            <WorkArt variant={item.variant} caption={item.artCaption} />
            <div class="work-card-content">
              <p class="card-eyebrow"><span>{item.category}</span><span>{item.number}</span></p>
              <h3 id={`${item.id}-title`}>{item.title}</h3>
              <p class="card-description">{item.description}</p>
              <div class="product-context"><h4>Product context</h4><p>{item.context}</p></div>
              <div class="contributions"><h4>My contributions</h4><ul>{item.contributions.map((contribution) => <li>{contribution}</li>)}</ul></div>
              <ul class="tags" aria-label="Technologies">{item.tags.map((tag) => <li>{tag}</li>)}</ul>
              <div class="product-references"><a href={item.source} aria-label={`${item.title} product overview`}>Product overview <span aria-hidden="true">↗</span></a><a href={item.announcement} aria-label={`${item.title} Build announcement`}>Build announcement <span aria-hidden="true">↗</span></a></div>
              <details class="case-study">
                <summary>Behind the work <span class="details-icon" aria-hidden="true">+</span></summary>
                <div class="case-study-body">
                  <h4>The problem</h4><p>{item.problem}</p>
                  <h4>My contribution</h4><p>{item.contribution}</p>
                  <h4>The thinking</h4><p>{item.decisions}</p>
                  <h4>The outcome</h4><p>{item.outcome}</p>
                </div>
              </details>
            </div>
          </article>
        ))}
      </div>
      <p class="work-disclaimer">Product context is based on Microsoft’s public announcements and documentation. My contributions describe my work within the wider product teams; internal details are intentionally omitted.</p>
    </section>

    <section id="experience" class="section experience-section" aria-labelledby="experience-title">
      <div class="container experience-layout">
        <div data-reveal><p class="eyebrow">02 / EXPERIENCE</p><h2 id="experience-title">Learning by<br /><em>building.</em></h2><p class="section-intro">From electrical engineering to cloud and AI.<br />A foundation in solving problems.</p><a class="text-link" href={`${base}resume/`}>The full résumé <span aria-hidden="true">↗</span></a></div>
        <div class="timeline">
          {experience.map((job) => (
            <article class="experience-item" data-reveal>
              <div class="job-meta"><span>{job.period}</span><span>{job.type}</span></div>
              <h3>{job.role}</h3><p class="company">{job.company}</p><p>{job.description}</p>
            </article>
          ))}
          <article class="experience-item education" data-reveal>
            <div class="job-meta"><span>2020 — 2024</span><span>Education</span></div>
            <h3>IIT Roorkee</h3><p class="company">B.Tech · Electrical Engineering</p><p>CGPA 8.55 / 10</p>
          </article>
        </div>
      </div>
    </section>

    <section id="projects" class="section container" aria-labelledby="projects-title">
      <div class="section-heading" data-reveal><div><p class="eyebrow">03 / EXPLORATIONS</p><h2 id="projects-title">Ideas into <em>practice.</em></h2></div><p>Different domains. The same curiosity<br />about how things work together.</p></div>
      <div class="project-list">
        {projects.map((project, index) => (
          <article class="project-row" data-reveal>
            <span class="project-number" aria-hidden="true">0{index + 1}</span>
            <div><p class="eyebrow">{project.category}</p><h3>{project.title}</h3><p>{project.description}</p><p class="project-tags">{project.tags}</p></div>
            <span class="project-date">{project.date}</span>
          </article>
        ))}
      </div>
      <a class="text-link github-link" href={profile.github}>Find me on GitHub <span aria-hidden="true">↗</span></a>
    </section>

    <section id="about" class="section container about-section" aria-labelledby="about-title">
      <div class="portrait-placeholder" data-reveal role="img" aria-label="Abstract S B monogram portrait placeholder">
        <div class="portrait-orbit orbit-one"></div><div class="portrait-orbit orbit-two"></div>
        <span class="portrait-initials">sb<span>.</span></span>
        <div class="portrait-caption"><span>A WORK IN PROGRESS, ALWAYS.</span><span aria-hidden="true">↗</span></div>
      </div>
      <div class="about-copy" data-reveal><p class="eyebrow">04 / A LITTLE ABOUT ME</p><h2 id="about-title">An engineer.<br />A systems <em>thinker.</em></h2><p class="about-lead">I’m Srushti, a software engineer at Microsoft and an IIT Roorkee graduate.</p><p>I work on Microsoft Discovery across its enterprise platform and local agentic AI app. I’m interested in the connections: between services, between tools, and between an engineering decision and the experience it creates.</p><p>My electrical engineering background and work in robotics gave me a starting point for thinking across boundaries. Today, I bring that perspective to software.</p><p>Outside of work, I’m a gym enthusiast and always up for a game of badminton or table tennis, or a swim. I also love travelling.</p><a class="text-link" href={profile.linkedin}>More on LinkedIn <span aria-hidden="true">↗</span></a></div>
    </section>

    <section id="contact" class="contact-section" aria-labelledby="contact-title">
      <div class="container" data-reveal><p class="eyebrow">05 / SAY HELLO</p><div class="contact-heading"><h2 id="contact-title">Good things start<br />with a <em>conversation.</em></h2><a class="contact-arrow" href={`mailto:${profile.email}`} aria-label="Email Srushti Borate"><span aria-hidden="true">↗</span></a></div><a class="email-link" href={`mailto:${profile.email}`}>{profile.email}</a><div class="contact-bottom"><p>Have an idea or a shared interest? Say hello.</p><div><a href={profile.github}>GitHub <span aria-hidden="true">↗</span></a><a href={profile.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a><a href={`${base}resume/`}>Résumé <span aria-hidden="true">↗</span></a></div></div></div>
    </section>
  </main>
  <footer class="site-footer container"><a class="wordmark" href={base}>srushti<span>.</span></a><p>© {new Date().getFullYear()} Srushti Borate</p><a href="#main">Back to top <span aria-hidden="true">↑</span></a></footer>
</Layout>
