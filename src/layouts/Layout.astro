---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Srushti Borate — Software Engineer',
  description = 'Srushti Borate is a software engineer at Microsoft and one of the founding engineers of Microsoft Discovery, working across its enterprise platform and local agentic AI app.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101816" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{title}</title>
    <script is:inline>
      try {
        const preference = localStorage.getItem('devportfolio-theme');
        document.documentElement.dataset.theme = preference === 'dark' || preference === 'light'
          ? preference
          : 'dark';
      } catch (error) {
        if (error instanceof DOMException) console.warn('Theme preference could not be loaded.', error);
        else throw error;
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
